########################################################
# Plantilla Keycloak OIDC — copiar a .env y pegar el secret:
#   cp ejemplo.env.keycloak .env
#
# Secret: Keycloak → plantilla-front → Clients → gestion-documental-api
#         → Credentials → Client secret
########################################################

KEYCLOAK_AUTH_SERVER_URL=https://keycloack-dev.iess.gob.ec/realms/plantilla-front
KEYCLOAK_CLIENT_ID=gestion-documental-api
KEYCLOAK_CLIENT_SECRET=PEGA_AQUI_TU_CLIENT_SECRET

KEYCLOAK_OIDC_ENABLED=true
KEYCLOAK_TOKEN_AZP=plantilla-front-cliente
KEYCLOAK_TOKEN_AUDIENCE=account

QUARKUS_PROFILE=dev
